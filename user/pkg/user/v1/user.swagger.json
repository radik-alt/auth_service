                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "title": "output only"
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time",
                  "title": "output only"
                }
              },
              "title": "user.user_id обязателен, остальные поля берутся согласно update_mask."
